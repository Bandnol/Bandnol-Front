{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "ios": {
        "simulator": false,
        "env": {
          "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "3f1a335fff3a83c39dd10e4443ed3159"
        }
      },
      "android": {
        "gradleCommand": ":app:assembleRelease",
        "env": {
          "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "3f1a335fff3a83c39dd10e4443ed3159"
        }
      },
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "3f1a335fff3a83c39dd10e4443ed3159"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
