{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@env": ["./node_modules/react-native-dotenv"]
    },
    "types": ["node", "./.env.d.ts"]
  },
  "include": [
    "**/*.ts",
    "types/svg.d.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    ".env.d.ts"
  ]
}
